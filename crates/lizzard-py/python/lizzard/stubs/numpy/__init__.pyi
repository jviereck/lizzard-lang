# lizzard: overlay numpy>=2.2,<3
# type: ignore  (an overlay is only meaningful merged onto NumPy's own stubs)
# lizzard's overlay for NumPy. The members declared here replace NumPy's own
# declarations of the same name: a class re-declared here keeps NumPy's bases
# and type parameters and only swaps the members listed. Everything else,
# including `numpy.typing`, the scalar types and `dtype`, comes from NumPy's
# own .pyi files. Declarations here may only be more precise than NumPy's,
# never contradict them, and use only NumPy's public names (its private
# TypeVars change between releases).
from typing import Any, Self, overload

type _Vec[S: generic] = ndarray[tuple[int], dtype[S]]
type _Mat[S: generic] = ndarray[tuple[int, int], dtype[S]]

class ndarray:
    @property
    def shape[Sh: tuple[int, ...]](self: ndarray[Sh, Any]) -> Sh: ...
    @property
    def ndim(self) -> int: ...
    @property
    def size(self) -> int: ...
    def __len__(self) -> int: ...

    # Indexing: precise for 1-D and 2-D arrays. On an array of unknown ndim
    # (`npt.NDArray`) an int index matches several overloads, so it is `Any`.
    @overload
    def __getitem__[S: generic](self: _Vec[S], key: int, /) -> S: ...
    @overload
    def __getitem__[S: generic](self: _Mat[S], key: tuple[int, int], /) -> S: ...
    @overload
    def __getitem__[S: generic](self: _Mat[S], key: int, /) -> _Vec[S]: ...
    @overload
    def __getitem__(self, key: slice, /) -> Self: ...
    @overload
    def __getitem__(self, key: Any, /) -> Any: ...

    @overload
    def __setitem__[S: generic](self: _Vec[S], key: int, value: S, /) -> None: ...
    @overload
    def __setitem__(self, key: Any, value: Any, /) -> None: ...

    # Arithmetic: the same shape and dtype give the same type; everything
    # else (broadcasting, dtype promotion) is left to NumPy and typed `Any`.
    @overload
    def __add__(self, other: Self, /) -> Self: ...
    @overload
    def __add__(self, other: Any, /) -> Any: ...
    @overload
    def __sub__(self, other: Self, /) -> Self: ...
    @overload
    def __sub__(self, other: Any, /) -> Any: ...
    @overload
    def __mul__(self, other: Self, /) -> Self: ...
    @overload
    def __mul__(self, other: Any, /) -> Any: ...

    def astype[Sh: tuple[int, ...], S: generic](self: ndarray[Sh, Any], dtype: type[S], /) -> ndarray[Sh, dtype[S]]: ...

class floating:
    # The same precision keeps the type; anything else is `floating`. (A
    # Python float is a "weak" scalar under NEP 50 and keeps this precision,
    # but a value typed `float` may be an `np.float64`, which promotes.)
    @overload
    def __add__(self, other: Self, /) -> Self: ...
    @overload
    def __add__(self, other: floating, /) -> floating: ...
    @overload
    def __add__(self, other: float, /) -> floating: ...
    def __radd__(self, other: float, /) -> floating: ...
    @overload
    def __sub__(self, other: Self, /) -> Self: ...
    @overload
    def __sub__(self, other: floating, /) -> floating: ...
    @overload
    def __sub__(self, other: float, /) -> floating: ...
    def __rsub__(self, other: float, /) -> floating: ...
    @overload
    def __mul__(self, other: Self, /) -> Self: ...
    @overload
    def __mul__(self, other: floating, /) -> floating: ...
    @overload
    def __mul__(self, other: float, /) -> floating: ...
    def __rmul__(self, other: float, /) -> floating: ...
    @overload
    def __truediv__(self, other: Self, /) -> Self: ...
    @overload
    def __truediv__(self, other: floating, /) -> floating: ...
    @overload
    def __truediv__(self, other: float, /) -> floating: ...
    def __rtruediv__(self, other: float, /) -> floating: ...

def arange[S: generic](stop: int, /, *, dtype: type[S]) -> ndarray[tuple[int], dtype[S]]: ...
def full[S: generic](shape: int, fill_value: float, *, dtype: type[S]) -> ndarray[tuple[int], dtype[S]]: ...
@overload
def zeros(shape: int, /) -> ndarray[tuple[int], dtype[float64]]: ...
@overload
def zeros(shape: tuple[int, int], /) -> ndarray[tuple[int, int], dtype[float64]]: ...
def empty_like[Sh: tuple[int, ...], D: dtype[Any]](prototype: ndarray[Sh, D], /) -> ndarray[Sh, D]: ...
