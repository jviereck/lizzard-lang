# Lizzard's definitions for the standard `threading` module. A standard-library
# module without such a file is opaque: Lizzard code can call into it, but a
# class deriving from one of its classes cannot be constructed or use members
# it does not declare itself (the checker is strict and has nothing to go on). `threading.local` is left out on purpose: its instances
# take arbitrary attributes, which a strict checker cannot follow.
from typing import Any, Callable, Protocol

TIMEOUT_MAX: float

class Thread:
    def __init__(
        self,
        group: None = None,
        target: Callable[..., object] | None = None,
        name: str | None = None,
        args: tuple[Any, ...] = (),
        kwargs: dict[str, Any] | None = None,
        *,
        daemon: bool | None = None,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @name.setter
    def name(self, value: str) -> None: ...
    @property
    def daemon(self) -> bool: ...
    @daemon.setter
    def daemon(self, value: bool) -> None: ...
    @property
    def ident(self) -> int | None: ...
    @property
    def native_id(self) -> int | None: ...
    def start(self) -> None: ...
    def run(self) -> None: ...
    def join(self, timeout: float | None = None) -> None: ...
    def is_alive(self) -> bool: ...

class Timer(Thread):
    def __init__(
        self,
        interval: float,
        function: Callable[..., object],
        args: tuple[Any, ...] | None = None,
        kwargs: dict[str, Any] | None = None,
    ) -> None: ...
    def cancel(self) -> None: ...

class Lock:
    def __init__(self) -> None: ...
    def acquire(self, blocking: bool = True, timeout: float = -1) -> bool: ...
    def release(self) -> None: ...
    def locked(self) -> bool: ...
    def __enter__(self) -> bool: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> None: ...

# `RLock` is a factory function at runtime, so its result is a protocol.
class _RLock(Protocol):
    def acquire(self, blocking: bool = True, timeout: float = -1) -> bool: ...
    def release(self) -> None: ...
    def __enter__(self) -> bool: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> None: ...

def RLock() -> _RLock: ...

class Condition:
    def __init__(self, lock: Lock | _RLock | None = None) -> None: ...
    def acquire(self, blocking: bool = True, timeout: float = -1) -> bool: ...
    def release(self) -> None: ...
    def wait(self, timeout: float | None = None) -> bool: ...
    def wait_for(self, predicate: Callable[[], object], timeout: float | None = None) -> Any: ...
    def notify(self, n: int = 1) -> None: ...
    def notify_all(self) -> None: ...
    def __enter__(self) -> bool: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> None: ...

class Semaphore:
    def __init__(self, value: int = 1) -> None: ...
    def acquire(self, blocking: bool = True, timeout: float | None = None) -> bool: ...
    def release(self, n: int = 1) -> None: ...
    def __enter__(self) -> bool: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> None: ...

class BoundedSemaphore(Semaphore): ...

class Event:
    def __init__(self) -> None: ...
    def is_set(self) -> bool: ...
    def set(self) -> None: ...
    def clear(self) -> None: ...
    def wait(self, timeout: float | None = None) -> bool: ...

class Barrier:
    def __init__(self, parties: int, action: Callable[[], object] | None = None, timeout: float | None = None) -> None: ...
    @property
    def parties(self) -> int: ...
    @property
    def n_waiting(self) -> int: ...
    @property
    def broken(self) -> bool: ...
    def wait(self, timeout: float | None = None) -> int: ...
    def reset(self) -> None: ...
    def abort(self) -> None: ...

class BrokenBarrierError(RuntimeError): ...

def current_thread() -> Thread: ...
def main_thread() -> Thread: ...
def active_count() -> int: ...
def enumerate() -> list[Thread]: ...
def get_ident() -> int: ...
def get_native_id() -> int: ...
