# slim: overlay mini>=1.0
from typing import Any, Self, overload

class Box:
    def label(self) -> int: ...
    @overload
    def pick[S](self: Box[f64], key: int, /) -> f64: ...
    @overload
    def pick(self: Box[f32], key: int, /) -> str: ...
    def same(self, other: Self, /) -> Self: ...

def make_any() -> Box[Any]: ...
