# Lizzard's definitions for the builtins it types: the containers (`list`,
# `dict`, `set`, `tuple`), `str` methods, iteration and generators, and
# builtin functions. Bundled into the front end until it bundles typeshed.
# `int`, `float`, `bool`, `str`, `tuple`, `object`, `type`, `None` and the
# exception classes are built into the checker; the `str` and `tuple`
# classes here only supply their methods. A few signatures that return
# `X | None` in typeshed return `Any` instead, so that ordinary use needs no
# narrowing (`dict.get(key)`).
from typing import Any, Callable, Generic, Protocol, TypeVar, overload

_T = TypeVar("_T")
_S = TypeVar("_S")
_K = TypeVar("_K")
_V = TypeVar("_V")
_T_co = TypeVar("_T_co", covariant=True)
_K_co = TypeVar("_K_co", covariant=True)
_V_co = TypeVar("_V_co", covariant=True)
_Y_co = TypeVar("_Y_co", covariant=True)
_S_contra = TypeVar("_S_contra", contravariant=True)
_R_co = TypeVar("_R_co", covariant=True)

class Iterable(Generic[_T_co]):
    def __iter__(self) -> Iterator[_T_co]: ...

class Iterator(Iterable[_T_co]):
    def __next__(self) -> _T_co: ...
    def __iter__(self) -> Iterator[_T_co]: ...

# Protocols: classes match them by their methods (`abs()` of a class with
# `__abs__`).
class SupportsAbs(Protocol[_T_co]):
    def __abs__(self) -> _T_co: ...

class _SupportsLT(Protocol):
    def __lt__(self, other: Any, /) -> bool: ...

# What a generator function returns: it yields `_Y_co`, accepts `_S_contra`
# from `send()`, and its `return` value is `_R_co` (`StopIteration.value`).
class Generator(Iterator[_Y_co], Generic[_Y_co, _S_contra, _R_co]):
    def __next__(self) -> _Y_co: ...
    def __iter__(self) -> Generator[_Y_co, _S_contra, _R_co]: ...
    def send(self, value: _S_contra, /) -> _Y_co: ...
    def throw(self, exc: BaseException, /) -> _Y_co: ...
    def close(self) -> None: ...

class Sequence(Iterable[_T_co]):
    def __len__(self) -> int: ...
    def __contains__(self, value: object, /) -> bool: ...
    def __iter__(self) -> Iterator[_T_co]: ...

class slice:
    start: Any
    stop: Any
    step: Any

class list(Sequence[_T]):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, iterable: Iterable[_T], /) -> None: ...
    def append(self, object: _T, /) -> None: ...
    def extend(self, iterable: Iterable[_T], /) -> None: ...
    def insert(self, index: int, object: _T, /) -> None: ...
    def pop(self, index: int = -1, /) -> _T: ...
    def remove(self, value: _T, /) -> None: ...
    def index(self, value: _T, /) -> int: ...
    def count(self, value: _T, /) -> int: ...
    def clear(self) -> None: ...
    def copy(self) -> list[_T]: ...
    def reverse(self) -> None: ...
    def sort(self, *, key: Callable[[_T], Any] | None = None, reverse: bool = False) -> None: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, i: int, /) -> _T: ...
    @overload
    def __getitem__(self, s: slice, /) -> list[_T]: ...
    @overload
    def __setitem__(self, i: int, value: _T, /) -> None: ...
    @overload
    def __setitem__(self, s: slice, value: Iterable[_T], /) -> None: ...
    @overload
    def __delitem__(self, i: int, /) -> None: ...
    @overload
    def __delitem__(self, s: slice, /) -> None: ...
    def __contains__(self, value: object, /) -> bool: ...
    def __iter__(self) -> Iterator[_T]: ...
    def __add__(self, other: list[_T], /) -> list[_T]: ...
    def __mul__(self, n: int, /) -> list[_T]: ...
    def __rmul__(self, n: int, /) -> list[_T]: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...

class dict_keys(Iterable[_K_co]):
    def __len__(self) -> int: ...
    def __contains__(self, key: object, /) -> bool: ...
    def __iter__(self) -> Iterator[_K_co]: ...

class dict_values(Iterable[_V_co]):
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[_V_co]: ...

class dict_items(Iterable[tuple[_K_co, _V_co]], Generic[_K_co, _V_co]):
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[tuple[_K_co, _V_co]]: ...

class dict(Iterable[_K], Generic[_K, _V]):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, other: dict[_K, _V], /) -> None: ...
    def keys(self) -> dict_keys[_K]: ...
    def values(self) -> dict_values[_V]: ...
    def items(self) -> dict_items[_K, _V]: ...
    # `get(key)` returns `V | None` in typeshed.
    @overload
    def get(self, key: _K, default: _V, /) -> _V: ...
    @overload
    def get(self, key: _K, /) -> Any: ...
    @overload
    def pop(self, key: _K, /) -> _V: ...
    @overload
    def pop(self, key: _K, default: _V, /) -> _V: ...
    def setdefault(self, key: _K, default: _V, /) -> _V: ...
    def update(self, other: dict[_K, _V], /) -> None: ...
    def clear(self) -> None: ...
    def copy(self) -> dict[_K, _V]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: _K, /) -> _V: ...
    def __setitem__(self, key: _K, value: _V, /) -> None: ...
    def __delitem__(self, key: _K, /) -> None: ...
    def __contains__(self, key: object, /) -> bool: ...
    def __iter__(self) -> Iterator[_K]: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...

class set(Iterable[_T]):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, iterable: Iterable[_T], /) -> None: ...
    def add(self, element: _T, /) -> None: ...
    def remove(self, element: _T, /) -> None: ...
    def discard(self, element: _T, /) -> None: ...
    def pop(self) -> _T: ...
    def clear(self) -> None: ...
    def copy(self) -> set[_T]: ...
    def update(self, other: Iterable[_T], /) -> None: ...
    def union(self, other: Iterable[_T], /) -> set[_T]: ...
    def intersection(self, other: Iterable[_T], /) -> set[_T]: ...
    def difference(self, other: Iterable[_T], /) -> set[_T]: ...
    def symmetric_difference(self, other: Iterable[_T], /) -> set[_T]: ...
    def issubset(self, other: Iterable[_T], /) -> bool: ...
    def issuperset(self, other: Iterable[_T], /) -> bool: ...
    def isdisjoint(self, other: Iterable[_T], /) -> bool: ...
    def __len__(self) -> int: ...
    def __contains__(self, value: object, /) -> bool: ...
    def __iter__(self) -> Iterator[_T]: ...
    def __or__(self, other: set[_T], /) -> set[_T]: ...
    def __and__(self, other: set[_T], /) -> set[_T]: ...
    def __sub__(self, other: set[_T], /) -> set[_T]: ...
    def __xor__(self, other: set[_T], /) -> set[_T]: ...
    def __le__(self, other: set[_T], /) -> bool: ...
    def __lt__(self, other: set[_T], /) -> bool: ...
    def __ge__(self, other: set[_T], /) -> bool: ...
    def __gt__(self, other: set[_T], /) -> bool: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...

class tuple(Sequence[_T_co]):
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, i: int, /) -> _T_co: ...
    @overload
    def __getitem__(self, s: slice, /) -> tuple[_T_co, ...]: ...
    def __contains__(self, value: object, /) -> bool: ...
    def __iter__(self) -> Iterator[_T_co]: ...
    def __add__(self, other: tuple[_T_co, ...], /) -> tuple[_T_co, ...]: ...
    def __mul__(self, n: int, /) -> tuple[_T_co, ...]: ...
    def count(self, value: object, /) -> int: ...
    def index(self, value: object, /) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...

class str(Sequence[str]):
    def join(self, iterable: Iterable[str], /) -> str: ...
    def split(self, sep: str = ..., maxsplit: int = -1) -> list[str]: ...
    def strip(self, chars: str = ..., /) -> str: ...
    def lstrip(self, chars: str = ..., /) -> str: ...
    def rstrip(self, chars: str = ..., /) -> str: ...
    def upper(self) -> str: ...
    def lower(self) -> str: ...
    def title(self) -> str: ...
    def capitalize(self) -> str: ...
    def startswith(self, prefix: str, /) -> bool: ...
    def endswith(self, suffix: str, /) -> bool: ...
    def replace(self, old: str, new: str, count: int = -1, /) -> str: ...
    def find(self, sub: str, /) -> int: ...
    def index(self, sub: str, /) -> int: ...
    def count(self, sub: str, /) -> int: ...
    def isdigit(self) -> bool: ...
    def isalpha(self) -> bool: ...
    def isspace(self) -> bool: ...
    def ljust(self, width: int, fillchar: str = " ", /) -> str: ...
    def rjust(self, width: int, fillchar: str = " ", /) -> str: ...
    def center(self, width: int, fillchar: str = " ", /) -> str: ...
    def format(self, *args: Any, **kwargs: Any) -> str: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, i: int, /) -> str: ...
    @overload
    def __getitem__(self, s: slice, /) -> str: ...
    def __contains__(self, value: str, /) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def __mul__(self, n: int, /) -> str: ...
    def __rmul__(self, n: int, /) -> str: ...
    def __mod__(self, value: Any, /) -> str: ...

class range(Sequence[int]):
    @overload
    def __init__(self, stop: int, /) -> None: ...
    @overload
    def __init__(self, start: int, stop: int, step: int = 1, /) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int, /) -> int: ...
    def __contains__(self, value: object, /) -> bool: ...
    def __iter__(self) -> Iterator[int]: ...

def isinstance(obj: object, class_or_tuple: Any, /) -> bool: ...
def callable(obj: object, /) -> bool: ...
def hash(obj: object, /) -> int: ...
def id(obj: object, /) -> int: ...
def any(iterable: Iterable[object], /) -> bool: ...
def all(iterable: Iterable[object], /) -> bool: ...
def ord(c: str, /) -> int: ...
def chr(i: int, /) -> str: ...
def hex(x: int, /) -> str: ...
def bin(x: int, /) -> str: ...
def oct(x: int, /) -> str: ...
def input(prompt: str = "", /) -> str: ...
def open(file: str, mode: str = "r", buffering: int = -1, encoding: str | None = None) -> Any: ...
def iter(iterable: Iterable[_T], /) -> Iterator[_T]: ...
@overload
def next(iterator: Iterator[_T], /) -> _T: ...
@overload
def next(iterator: Iterator[_T], default: _T, /) -> _T: ...
@overload
def round(number: float, /) -> int: ...
@overload
def round(number: float, ndigits: int, /) -> float: ...
def divmod(a: int, b: int, /) -> tuple[int, int]: ...
def repr(obj: object, /) -> str: ...
def enumerate(iterable: Iterable[_T], start: int = 0) -> Iterator[tuple[int, _T]]: ...
def zip(a: Iterable[_T], b: Iterable[_S], /) -> Iterator[tuple[_T, _S]]: ...
def sorted(iterable: Iterable[_T], /, *, key: Callable[[_T], Any] | None = None, reverse: bool = False) -> list[_T]: ...
def map(func: Callable[[_T], _S], iterable: Iterable[_T], /) -> Iterator[_S]: ...
def filter(func: Callable[[_T], object] | None, iterable: Iterable[_T], /) -> Iterator[_T]: ...
def reversed(seq: Sequence[_T], /) -> Iterator[_T]: ...
@overload
def sum(iterable: Iterable[int], /) -> int: ...
@overload
def sum(iterable: Iterable[float], /) -> float: ...
@overload
def abs(x: int, /) -> int: ...
@overload
def abs(x: float, /) -> float: ...
@overload
def abs(x: SupportsAbs[_T], /) -> _T: ...
@overload
def min(a: int, b: int, /) -> int: ...
@overload
def min(a: float, b: float, /) -> float: ...
@overload
def min[C: _SupportsLT](a: C, b: C, /) -> C: ...
@overload
def min(iterable: Iterable[_T], /, *, key: Callable[[_T], Any] | None = None) -> _T: ...
@overload
def max(a: int, b: int, /) -> int: ...
@overload
def max(a: float, b: float, /) -> float: ...
@overload
def max[C: _SupportsLT](a: C, b: C, /) -> C: ...
@overload
def max(iterable: Iterable[_T], /, *, key: Callable[[_T], Any] | None = None) -> _T: ...
