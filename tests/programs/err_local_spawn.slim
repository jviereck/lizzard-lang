# A closure that captures a local value is local, so it cannot run on
# another thread.
class Counter:
    n: int
    def __init__(self) -> ():
        self.n = 0
    def inc(self) -> int:
        self.n += 1
        self.n

def main() -> ():
    c = Counter::<+local>()
    work = || c.inc()
    print(work())
    spawn(work).join()

main()
