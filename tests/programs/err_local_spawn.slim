# A closure that captures a local value is local (`function + Local`), so it
# cannot run on another thread.
class Counter(impl Local):
    n: int
    def __init__(self) -> ():
        self.n = 0
    def inc(self) -> int:
        self.n += 1
        self.n

def main() -> ():
    c = Counter()
    work = || c.inc()
    print(work())
    spawn(work).join()

main()
