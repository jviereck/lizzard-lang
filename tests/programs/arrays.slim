# array<T>: fixed-size packed scalars with checked access.
a = array(f64, 4)
a[1] = 2.5
a[2] = 3
print(a, len(a), a[1], a.sum())
b = array(u8, [1, 2, 255])
print(b, b.to_list(), 2 in b)
v = a.view(1, 2)
v[0] = 9.0
print(v, a)
c = array(bool, 3)
c[1] = True
print(c, c.sum())
f = array(f32, [0.1, 1.5])
print(f)
for x in b:
    print(x)
print(a == a.copy(), array(i64, [1, 2]) == array(f64, [1.0, 2.0]))

def dot(a: array<f64>, b: array<f64>) -> float:
    s = 0.0
    for i in range(len(a)):
        s += a[i] * b[i]
    s

class Grid:
    cells: array<u8>
    w: int
    def __init__(self, w: int) -> ():
        self.cells <- array(u8, w * w)
        self.w = w
    def set(self, x: int, y: int, v: int) -> ():
        self.cells[y * self.w + x] = v
    def get(self, x: int, y: int) -> int:
        self.cells[y * self.w + x]

def main() -> ():
    xs = array(f64, [1.0, 2.0, 3.0])
    ys = array(f64, [4.0, 5.0, 6.0])
    print(dot(xs, ys))
    v = xs[1]
    print(v + 1.0)
    g = Grid(4)
    g.set(1, 2, 200)
    print(g.get(1, 2), g.cells.sum())
main()

# Elements are copies: no ++ or <- needed, and the array is unaffected.
def bump(a: array<i32>) -> ():
    x = a[0]
    x += 1
    a[1] = x
nums = array(i32, [10, 0])
bump(nums)
print(nums)
old <- nums[0] <- 7
print(old, nums)
