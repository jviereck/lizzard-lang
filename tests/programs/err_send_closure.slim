# A closure capturing a value that is not `Send` cannot be stored as
# `function + Send`.
struct Bag:
    item: any

impl Bag:
    def new(item: any + keep) -> Self:
        Bag { item }

struct Job:
    run: function + Send

def main() -> ():
    b = Bag::new(1)
    job = Job { run: || str(b.item) }

main()
