# Type arguments must satisfy the struct's bounds.
struct SortedBag<T: Ord>:
    items: list<T>

impl<T: Ord> SortedBag<T>:
    def new() -> Self:
        SortedBag { items: [] }
    def add(self, x: T + keep) -> ():
        self.items.append(x)
        self.items <- sorted(self.items)

ok = SortedBag::<int>::new()
ok.add(3)
bad = SortedBag::<list<int>>::new()
