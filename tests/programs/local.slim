# Thread locality: a class is local if it implements `Local` (or has a field
# of local type), and its instances never leave the thread that created them.
# Types that hide what they hold (`any`, `function`, `Iterator<T>`, traits)
# are written `+ Local` when they may hold local values.

class Counter(impl Local):
    n: int
    def __init__(self) -> ():
        self.n = 0
    def inc(self) -> int:
        self.n += 1
        self.n

# A class with a local field is local itself.
class Holder:
    c: Counter
    def __init__(self, c: Counter + keep) -> ():
        self.c <- c

class Box<T>:
    value: T
    def __init__(self, value: T + keep) -> ():
        self.value <- value

trait Ticker:
    def tick(self) -> int: ...

class Clock(impl Ticker):
    t: int
    def __init__(self) -> ():
        self.t = 0
    def tick(self) -> int:
        self.t += 10
        self.t

class LocalClock(impl Ticker, Local):
    t: int
    def __init__(self) -> ():
        self.t = 0
    def tick(self) -> int:
        self.t += 1
        self.t

def bump(c: Counter) -> int:
    c.inc()

def describe(x: any + Local) -> str:
    "got " + str(x)

def tick_all(ts: list<Ticker + Local>) -> int:
    total = 0
    for t in ts:
        total += t.tick()
    total

def ticks() -> Iterator<int> + Local:
    c = Counter()
    yield c.inc()
    yield c.inc()

def square(n: int) -> int:
    n * n

def run<T: Send>(f: function, x: T + keep) -> Thread:
    spawn(f, x)

def make_counter() -> Counter:
    Counter()

def main() -> ():
    c = Counter()
    print(c, bump(c), bump(c))

    # Locality comes from the class: no annotation at the use site.
    h = Holder(Counter())
    print(h.c.inc())
    b = Box(Counter())
    print(b.value.inc(), b.value.inc())
    xs: list<Counter> = [Counter(), Counter()]
    xs.append(c++)
    print(len(xs), xs[2].inc())
    plain = Box(5)
    print(plain.value)

    # Erased types: `+ Local` admits local values.
    print(describe(c))
    print(describe(5))
    print(tick_all([Clock(), LocalClock(), LocalClock()]))
    f = |k: int| c.inc() + k
    print(f(100))
    held: list<function + Local> = [f, |k: int| k]
    print(len(held))
    for x in ticks():
        print("tick", x)

    # Non-local values still cross threads, also from generic code.
    print(run(square, 7).join())
    print(spawn(square, 6).join())

    # Statically unknown values are checked at runtime.
    shared: list<any> = []
    g = make_counter
    try:
        shared.append(g())
    except TypeError as e:
        print("error:", e)
    print(len(shared))

main()
