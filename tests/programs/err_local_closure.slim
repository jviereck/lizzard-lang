# A closure capturing a local value cannot be stored as a plain `function`.
class Counter(impl Local):
    n: int
    def __init__(self) -> ():
        self.n = 0
    def inc(self) -> int:
        self.n += 1
        self.n

class Job:
    run: function
    def __init__(self, run: function + keep) -> ():
        self.run <- run

def main() -> ():
    c = Counter()
    job = Job(|| c.inc())

main()
