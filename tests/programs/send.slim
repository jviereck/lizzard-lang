# `Send`, as in Rust: a type is `Send` unless it holds something that is not.
# `any`, `function`, `Iterator<T>` and trait types may hold values that are
# not `Send`; `X + Send` restricts them to values that are.

# `Send`: only an `int` field.
struct Counter:
    n: int

impl Counter:
    def new() -> Self:
        Counter { n: 0 }
    def inc(self) -> int:
        self.n += 1
        self.n

# Not `Send`: an `any` field may hold anything.
struct Bag:
    item: any

impl Bag:
    def new(item: any + keep) -> Self:
        Bag { item }

# Not `Send`: a field of a type that is not.
struct Holder:
    b: Bag

# `Send` exactly when `T` is.
struct Box<T>:
    value: T

trait Ticker:
    def tick(self) -> int: ...

struct Clock:
    t: int

impl Ticker for Clock:
    def tick(self) -> int:
        self.t += 10
        self.t

struct BagClock:
    b: Bag

impl Ticker for BagClock:
    def tick(self) -> int:
        1

def show(x: any) -> str:
    "got " + str(x)

def tick_all(ts: list<Ticker>) -> int:
    total = 0
    for t in ts:
        total += t.tick()
    total

def ticks() -> Iterator<int>:
    b = Bag::new(0)
    yield 1
    yield 2

def counts() -> Iterator<int> + Send:
    c = Counter::new()
    yield c.inc()
    yield c.inc()

def square(n: int) -> int:
    n * n

def bump(c: Counter + keep) -> int:
    c.inc()

def unbox(b: Box<Counter> + keep) -> int:
    b.value.inc() + 10

def total_len(xs: list<any + Send>) -> int:
    len(xs)

def run<T: Send>(f: function + Send, x: T + keep) -> Thread:
    spawn(f, x)

def make_bag() -> Bag:
    Bag::new("made")

def main() -> ():
    b = Bag::new(5)
    print(b.item, show(b))
    h = Holder { b: Bag::new("x") }
    print(h.b.item)
    bb = Box { value: Bag::new(1) }
    print(bb.value.item)

    # `Send` values cross threads.
    print(spawn(bump, Counter::new()).join())
    print(spawn(unbox, Box { value: Counter::new() }).join())
    xs: list<any + Send> = [1, "a", 2.5]
    print(spawn(total_len, xs++).join())
    double = |k: int| k * 2
    print(spawn(double, 21).join())
    print(run(square, 7).join())

    # Erased types may hold values that are not `Send`.
    print(tick_all([Clock { t: 0 }, BagClock { b: Bag::new(1) }]))
    peek = |k: int| k + len(str(b.item))
    print(peek(100))
    held: list<function> = [peek, double]
    print(len(held))
    for x in ticks():
        print("tick", x)
    for x in counts():
        print("count", x)

    # Statically unknown values are checked at runtime.
    shared: list<any + Send> = []
    mk = make_bag
    try:
        shared.append(mk())
    except TypeError as e:
        print("error:", e)
    print(len(shared))

main()
