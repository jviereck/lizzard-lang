# A closure capturing a value that is not `Send` is a `function`, not
# a `function + Send`, so it cannot run on another thread.
class Bag:
    item: any
    def __init__(self, item: any + keep) -> ():
        self.item <- item

def main() -> ():
    b = Bag(1)
    work = || str(b.item)
    print(work())
    spawn(work).join()

main()
