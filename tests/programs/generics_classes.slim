# Generic classes: type arguments are part of the instance's runtime type.

class Stack<T>(impl Iterable<T>, impl Len):
    items: list<T>
    def __init__(self) -> ():
        self.items <- []
    def push(self, x: T + keep) -> ():
        self.items.append(x)
    def pop(self) -> Option<T>:
        self.items.pop()
    def __len__(self) -> int:
        len(self.items)
    def __iter__(self) -> Iterator<T>:
        for x in self.items:
            yield x++

class Box<T>:
    value: T
    def __init__(self, value: T + keep) -> ():
        self.value <- value
    def get(self) -> T:
        self.value++
    def swap(self, v: T + keep) -> T:
        old <- self.value <- v
        old

class Pair<A, B>:
    first: A
    second: B
    def __init__(self, a: A + keep, b: B + keep) -> ():
        self.first <- a
        self.second <- b
    def flip(self) -> Pair<B, A>:
        Pair(self.second++, self.first++)

def untyped(x: any) -> any:
    x++

def total(s: Stack<int>) -> int:
    n = 0
    for x in s:
        n += x
    n

def main() -> ():
    # Explicit type arguments.
    s = Stack::<int>()
    s.push(1)
    s.push(2)
    s.push(3)
    print(s, len(s), total(s))
    top = s.pop()
    if top is not None:
        print("popped", top + 10)

    # From the context.
    names: Stack<str> = Stack()
    names.push("ada")
    names.push("grace")
    for n in names:
        print(n.upper())

    # Inferred from the constructor arguments.
    b = Box(5)
    print(b, b.get() * 2)
    old = b.swap(7)
    print(old, b.value)
    p = Pair("x", 1.5)
    q = p.flip()
    print(p, q, q.first + 1.0, q.second.upper())

    # Nested generic types.
    nested = Stack::<list<int>>()
    nested.push([1, 2])
    nested.push([3])
    for xs in nested:
        print(xs, len(xs))
    boxes: list<Box<str>> = [Box("a"), Box("b")]
    print(boxes)

    # The runtime type is checked through untyped paths.
    try:
        untyped(s).push("four")
    except TypeError as e:
        print("error:", e)
    try:
        total(untyped(names))
    except TypeError as e:
        print("error:", e)
    try:
        bad: list<Box<int>> = untyped(boxes)
    except TypeError as e:
        print("error:", e)
    print(isinstance(b, Box), s)

main()
