# User traits as bounds, generic traits, and generic methods.

trait Shape:
    def area(self) -> float: ...
    def describe(self) -> str:
        "shape with area " + str(self.area())

struct Square:
    side: float

impl Square:
    def new(side: float) -> Self:
        Square { side }

impl Shape for Square:
    def area(self) -> float:
        self.side * self.side

impl Ord for Square:
    def __lt__(self, other: Square) -> bool:
        self.side < other.side

struct Circle:
    r: float

impl Circle:
    def new(r: float) -> Self:
        Circle { r }

impl Shape for Circle:
    def area(self) -> float:
        3.0 * self.r * self.r

# A bound gives static method resolution on `T`.
def total_area<T: Shape>(xs: list<T>) -> float:
    t = 0.0
    for x in xs:
        t += x.area()
    t

def biggest<T: Shape + Ord>(xs: list<T>) -> str:
    sorted(xs)[len(xs) - 1].describe()

# A generic trait: its default methods see the implementing type's argument.
trait Source<T>:
    def next_item(self) -> Option<T>: ...
    def collect(self) -> list<T>:
        out: list<T> = []
        item = self.next_item()
        while item is not None:
            out.append(item)
            item = self.next_item()
        out

struct Countdown:
    n: int

impl Countdown:
    def new(n: int) -> Self:
        Countdown { n }

impl Source<int> for Countdown:
    def next_item(self) -> Option<int>:
        if self.n == 0:
            None
        else:
            self.n -= 1
            self.n + 1

struct Repeat<T>:
    value: T
    times: int

impl<T> Repeat<T>:
    def new(value: T + keep, times: int) -> Self:
        Repeat { value, times }

impl<T> Source<T> for Repeat<T>:
    def next_item(self) -> Option<T>:
        if self.times == 0:
            None
        else:
            self.times -= 1
            self.value++

def drain<T>(s: Source<T>) -> list<T>:
    s.collect()

# A user iterator: `impl Iterator<T>` makes it usable in `for` and as an
# `Iterator<T>`.
struct Upto:
    i: int
    n: int

impl Upto:
    def new(n: int) -> Self:
        Upto { i: 0, n }

impl Iterator<int> for Upto:
    def __next__(self) -> int:
        if self.i >= self.n:
            raise StopIteration()
        self.i += 1
        self.i

def sum_all(xs: Iterable<int>) -> int:
    t = 0
    for x in xs:
        t += x
    t

# Generic methods take their own type parameters.
struct Registry:
    names: list<str>

impl Registry:
    def new() -> Self:
        Registry { names: [] }
    def tag<T>(self, x: T) -> tuple<str, T>:
        ("#" + str(len(self.names)), x++)

def untyped(x: any) -> any:
    x++

def main() -> ():
    shapes = [Square::new(2.0), Square { side: 1.0 }]
    print(total_area(shapes), total_area([Circle::new(1.0)]), biggest(shapes))
    print(Countdown::new(3).collect(), drain(Countdown::new(2)), drain(Repeat::new("ab", 2)))
    r = Repeat::<float>::new(1, 2)
    floats = r.collect()
    floats.append(0.5)
    print(floats, sum_all([1, 2]), sum_all(Upto::new(4)))
    for i in Upto::new(2):
        print("upto", i)
    reg = Registry::new()
    print(reg.tag(5), reg.tag("x"))
    try:
        total_area(untyped([1, 2]))
    except TypeError as e:
        print("error:", e)
    try:
        sum_all(untyped(["a"]))
    except TypeError as e:
        print("error:", e)

main()
