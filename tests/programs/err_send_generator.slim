# A generator declared `+ Send` may be resumed on another thread, so it
# cannot hold a value that is not `Send` across a `yield`.
struct Bag:
    item: any

impl Bag:
    def new(item: any + keep) -> Self:
        Bag { item }

def ticks() -> Iterator<int> + Send:
    b = Bag::new(1)
    yield 1
    yield 2

for t in ticks():
    print(t)
